# Copy to .env and fill from `cdk deploy` outputs. These are public identifiers, not secrets.
EXPO_PUBLIC_API_URL=https://xxxxxxxx.execute-api.us-west-2.amazonaws.com
EXPO_PUBLIC_PATIENT_POOL_ID=us-west-2_XXXXXXXXX
EXPO_PUBLIC_PATIENT_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Stripe publishable key (pk_test_... while testing)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
